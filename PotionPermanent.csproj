<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PotionPermanent</AssemblyName>
    <RootNamespace>PotionPermanent</RootNamespace>
    <!-- 模组 ID，需与 manifest.json 里的 "id" 一致 -->
    <ModId>potion-permanent</ModId>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 编译产物统一放 bin\，里面就是可以直接复制进 TerrariaModder\mods\ 的成品 -->
    <OutputPath>bin\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- 让 bin\ 里同时带上 manifest.json，整个文件夹就是可安装的成品 -->
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 框架 / 游戏引用：路径在 Directory.Build.props 里配置 -->
    <Reference Include="TerrariaModder.Core">
      <HintPath>$(ModderDir)core\TerrariaModder.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ModderDir)core\deps\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Terraria">
      <HintPath>$(TerrariaDir)Terraria.exe</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
