<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PotionPermanent</AssemblyName>
    <RootNamespace>PotionPermanent</RootNamespace>
    <ModId>potion-permanent</ModId>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 成品输出到本语言的 bin\，里面就是可以直接复制进 TerrariaModder\mods\ 的东西 -->
    <OutputPath>bin\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 核心逻辑没有界面文字，放在上层目录，两个语言版共用同一份 -->
    <Compile Include="..\BuffSustainer.cs" Link="BuffSustainer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TerrariaModder.Core">
      <HintPath>$(ModderDir)core\TerrariaModder.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ModderDir)core\deps\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Terraria">
      <HintPath>$(TerrariaDir)Terraria.exe</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>